# Copy this file to .env. Docker Compose loads .env automatically.
POSTGRES_DB=library_db
POSTGRES_USER=library_app
POSTGRES_PASSWORD=replace_with_your_database_password
POSTGRES_PORT=5433
APP_PORT=8080
TZ=Europe/Moscow

JWT_SECRET_BASE64=replace_with_base64_of_at_least_32_random_bytes
JWT_ISSUER=library-pks
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_NAME=Администратор
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_temporary_password_at_least_10_characters

# Export this for the desktop client when using another backend address.
LIBRARY_API_URL=http://localhost:8080

# For backend without Docker, export these variables in its terminal as well.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/library_db
SPRING_DATASOURCE_USERNAME=library_app
SPRING_DATASOURCE_PASSWORD=replace_with_your_database_password
