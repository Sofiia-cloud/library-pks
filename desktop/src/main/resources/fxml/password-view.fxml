<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="ru.mirea.library.fx.controller.PasswordController"
      fx:id="form" spacing="14" alignment="CENTER">
    <padding><Insets top="25" right="45" bottom="25" left="45"/></padding>
    <Label text="Смена пароля" styleClass="title"/>
    <Label text="Для временного пароля смена обязательна. После сохранения потребуется повторный вход." wrapText="true" maxWidth="400"/>
    <PasswordField fx:id="fieldCurrent" promptText="Текущий пароль"/>
    <PasswordField fx:id="fieldNew" promptText="Новый пароль — не менее 10 символов"/>
    <PasswordField fx:id="fieldConfirm" promptText="Повторите новый пароль"/>
    <HBox spacing="12" alignment="CENTER"><Button fx:id="btnSave" text="Сохранить" defaultButton="true" styleClass="primary-button"/><Button fx:id="btnBack" text="Назад / выход"/></HBox>
    <Label fx:id="lblError" wrapText="true" maxWidth="400"/>
</VBox>
