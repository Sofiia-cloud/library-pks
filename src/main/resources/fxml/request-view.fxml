<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.mirea.library.fx.controller.RequestController"
      spacing="10">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <Label text="Заявки на выдачу книг" styleClass="title"/>

    <HBox spacing="10" styleClass="toolbar">
        <Button fx:id="btnAdd"     text="Добавить"      styleClass="primary-button"/>
        <Button fx:id="btnEdit"    text="Редактировать"/>
        <Button fx:id="btnDelete"  text="Удалить"       styleClass="danger-button"/>
        <Button fx:id="btnRefresh" text="Обновить"/>
    </HBox>

    <TableView fx:id="requestTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colReader" text="Читатель" prefWidth="180"/>
            <TableColumn fx:id="colBookTitle" text="Название книги" prefWidth="200"/>
            <TableColumn fx:id="colAuthor" text="Автор" prefWidth="150"/>
            <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="100"/>
            <TableColumn fx:id="colStatus" text="Статус" prefWidth="110"/>
            <TableColumn fx:id="colCreatedAt" text="Создана" prefWidth="130"/>
            <TableColumn fx:id="colReturnDate" text="Вернуть до" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>