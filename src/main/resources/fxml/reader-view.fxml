<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.mirea.library.fx.controller.ReaderController">

    <top>
        <HBox spacing="10" styleClass="toolbar">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button fx:id="btnAdd"    text="Добавить"     styleClass="primary-button"/>
            <Button fx:id="btnEdit"   text="Редактировать"/>
            <Button fx:id="btnDelete" text="Удалить"      styleClass="danger-button"/>
            <Button fx:id="btnRefresh" text="Обновить"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="readerTable">
            <columns>
                <TableColumn fx:id="colId"     text="ID"            prefWidth="60"/>
                <TableColumn fx:id="colName"   text="ФИО"           prefWidth="220"/>
                <TableColumn fx:id="colEmail"  text="Email"         prefWidth="220"/>
                <TableColumn fx:id="colPhone"  text="Телефон"       prefWidth="140"/>
                <TableColumn fx:id="colCard"   text="Билет"         prefWidth="120"/>
                <TableColumn fx:id="colRegAt"  text="Регистрация"   prefWidth="160"/>
            </columns>
        </TableView>
    </center>

</BorderPane>